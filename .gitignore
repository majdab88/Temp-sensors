# PlatformIO build artifacts and downloaded libraries
.pio/

# Firmware signing keys — a leaked private key lets anyone flash the fleet.
# Never commit these; they belong on a dev machine, not in git or on the droplet.
*.pem
fw-signing-key*


# VS Code workspace file (optional — remove this line if you want to commit it)
*.code-workspace
sensor/.gitignore
sensor/.vscode/extensions.json
sensor-ntc/.vscode/extensions.json
sensor-ntc/.gitignore
.gitignore

# Publish helper config — contains a superadmin password.
publish.env

# Enclosure model: the FreeCAD document is a build artifact — rebuild it
# with sensor-ntc/enclosure/build-all.FCMacro rather than versioning it.
*.FCStd
*.FCStd1
*.FCBak
sensor-ntc/enclosure/*.csg
sensor-ntc/enclosure/enclosure.step
sensor-ntc/enclosure/*-Enclosure*.step

# Large local inputs for that model. esp32c6.step is a 6 MB KiCad board
# export (the build falls back to a plain reference box without it), and
# NTC_SENSOR.kicad_pcb is a copy of the board file that lives with the
# KiCad project — tracking it here would let the two drift.
sensor-ntc/enclosure/esp32c6.step
sensor-ntc/enclosure/NTC_SENSOR.kicad_pcb
# v3 board STEP for sensor-ntc-v3-toplid.sc, regenerated from pcb-v3 with
# kicad-cli pcb export step --subst-models --include-tracks.
sensor-ntc/enclosure/sensor-ntc-v3-board.step

# ESP-NOW message authentication key — anyone holding it can forge readings
# and configuration for every node. Only the template is versioned.
secrets/*
!secrets/*.example.h

# Local-only: secrets, per-user Claude settings, editor locks and backups.
secrets/
.claude/settings.local.json
*.pcbcraft-lock
.~*.lock
*.sc.bak
__pycache__/

# Enclosure renders: the GLB is a 5 MB re-export of the SolidCraft model
# (board included), regenerated before every render.
sensor-ntc/enclosure/render/*.glb

# Vendor 3D models (GrabCAD) used by the enclosure model; their licence does
# not cover redistribution in a public repo.
sensor-ntc/enclosure/models/

# sensor-wifi enclosure: board STEPs exported from the KiCad projects (regenerate,
# then component.update_links)
sensor-wifi/enclosure/*-board.step

# KiCad Fabrication Toolkit output (Gerbers, BOM, CPL) — regenerate from the
# board before every order; a committed copy goes stale with the next edit.
**/production/

# Mobile app: local build output. temp-sensors-app/.gitignore and
# android/.gitignore already keep these out of git, but `eas build` uploads the
# whole repository and reads only THIS file -- a leftover 1 GB android/app/build
# made one upload 408 MB, and an android/ folder in the upload can make EAS
# treat the project as bare and skip prebuild. Exclude them here, not in a
# root .easignore: that would replace this file for EAS, secrets/ and *.pem
# exclusions included.
temp-sensors-app/android/
temp-sensors-app/ios/
temp-sensors-app/dist/
temp-sensors-app/.expo/
temp-sensors-app/.idea/
