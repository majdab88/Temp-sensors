	(text "R4 ILIM ~1 A in · R5 ISET ~0.5 A charge · R6 TMR safety timer\nR7 ITERM: open = default termination (verify) · RT1 by U2: board temp\nEN2=1 EN1=0: input limit set by R4 · CE low: charge enabled"
		(at 114.3 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9c845f4f-1e80-44b4-8ad2-224b1f4ac2b6")
	)
	(text "Q1's gate is referenced to CELL_N, not GND: a reversed cell holds it off\neven with USB driving VBAT. DW01A fed via D2, so a reversed cell cannot\npower it; R14 holds the FS8205A charge FET off when it is unpowered.\nBT1: Keystone 1042 holder, must take 65 mm bare and 70 mm protected cells."
		(at 17.78 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "84637b30-e262-4ecd-9a00-8620b12b2626")
	)
	(text "L1: TDK VLS3015CX-1R5M-H (as v2)\nVout = 0.5 x (1 + R17/R18) = 3.3 V\nMODE = GND: power-save (PFM)"
		(at 210.82 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4caea4f5-54fa-420c-8f8e-27391c74c5e8")
	)
